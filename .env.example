# nwafu_deepseek_proxy 配置
# 复制此文件为 .env 并填入实际值

# === 必填 ===

# 统一身份认证学号
NWAFU_USERNAME=your_student_id

# 统一身份认证密码 (含 # 等特殊字符时用双引号包裹)
NWAFU_PASSWORD=your_password_here

# Open WebUI API Key (登录 Open WebUI → 个人设置 → 账号 → API 密钥)
OPENWEBUI_API_KEY=sk-your-api-key-here

# === 可选 ===

# 代理监听端口
PROXY_PORT=8000

# Open WebUI 域名
TARGET_HOST=deepseek.nwafu.edu.cn

# 金智 AuthServer 地址 (通常不需要改)
AUTH_SERVER=https://authserver.nwafu.edu.cn
