# nwafu_deepseek_proxy 配置
# 复制此文件为 .env 并填入实际值

# === 必填 ===

# 统一身份认证学号
NWAFU_USERNAME=your_student_id

# 统一身份认证密码 (含 # 等特殊字符时用双引号包裹)
NWAFU_PASSWORD=your_password_here

# Open WebUI API Key（登录 Open WebUI，在“个人设置 / 账号 / API 密钥”中生成）
OPENWEBUI_API_KEY=sk-your-api-key-here

# === 可选：FIDO2 / Passkey 登录（免密码 + 免验证码） ===
# 启用后代理通过 WebAuthn 签名完成 CAS 认证，完全绕过密码和滑块验证码
# 启用前需先配置凭据：python utils/extract_fido2.py bitwarden_export.json --name <Bitwarden条目名> --save --device-id <设备绑定ID>
# 详见 README.md「Passkey 登录」章节
FIDO2_ENABLED=false

# === 可选：TOTP 二次验证 ===
# 从认证器 APP 中获取 NWAFU 统一身份认证的 TOTP 密钥（Base32 字符串）
# 配置后代理可自动完成二次验证，无需人工干预
# 获取方式：认证器 APP → 账户详情 → 查看密钥/导出
TOTP_SECRET=

# 是否自动完成 TOTP（默认 true）。设为 false 时检测到二次验证会进入退避等待
TOTP_AUTO_ENABLED=true

# === 可选 ===

# 代理监听端口
PROXY_PORT=8000

# Open WebUI 域名
TARGET_HOST=deepseek.nwafu.edu.cn

# 金智 AuthServer 地址 (通常不需要改)
AUTH_SERVER=https://authserver.nwafu.edu.cn

# === 可选：模型变更监控 ===
# 启用后，代理会定期轮询模型列表，检测变化并通过 Telegram / Webhook 通知
MONITOR_ENABLED=false

# 轮询间隔（秒），默认 600（10 分钟），最小 300
MONITOR_POLL_INTERVAL=600

# Telegram 通知（需要 bot token 和 chat ID）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Webhook 通知（支持多个，逗号分隔）
WEBHOOK_URLS=
WEBHOOK_SECRET=

# 通知渠道的 HTTP 代理（socks5:// 或 http://）
NOTIFY_PROXY=
